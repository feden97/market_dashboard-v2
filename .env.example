# Dashboard Financiero — Environment Variables
# Copy this file to .env and fill in the values you need.

# Optional: URL of the centralized proxy server (BFF).
# When set, the dashboard fetches all live data from this single endpoint
# instead of making multiple direct API calls from the browser.
# Example: https://your-proxy.onrender.com/data
VITE_PROXY_URL=

# Optional override for the public Fiwind historical data JSON.
# Default: raw.githubusercontent.com/feden97/market_dashboard-v2/fiwind-history/fiwind.json
# For local collection, run scripts/collect_fiwind.py and set /data/fiwind.json.
VITE_FIWIND_HISTORY_URL=
